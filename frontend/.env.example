# Public URL the site is served from. Used for absolute Open Graph and
# Twitter card URLs. Leave unset in development; it falls back to
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Base URL of the Harbor backend API, called from the browser. Leave unset to
# use this app's same-origin /api proxy; the Next.js server forwards it to the
# backend at INTERNAL_API_URL (default http://localhost:8080). Only set this to
# bypass the proxy and call a backend on a different origin.
NEXT_PUBLIC_API_URL=

# Base domain the backend routes deployed apps under. Harbor creates a host of
# the form harbor-<first 8 chars of deployment ID>.{domain}, so set this to
# DOMAIN_NAME from the backend environment (for example, example.com). HTTPS is
# assumed; include http:// for a local Traefik instance that only serves :80.
NEXT_PUBLIC_DEPLOY_DOMAIN=
