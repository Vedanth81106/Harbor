# PostgreSQL
DB_USER=
DB_PWD=
DB_NAME=

# Authentication
# Base64URL-encoded HMAC secret used to sign JWTs.
JWT_SECRET_KEY=
# Base domain used in deployment hostnames.
DOMAIN=

# Cloudflare Tunnel
CLOUDFLARE_TOKEN=

# Host directory where Harbor stores cloned repositories.
# It is mounted into the backend container at /harbor-workspace.
# Defaults to ./tmp when unset.
HARBOR_WORKSPACE=./tmp

# Frontend (Docker image build-time values)
# NEXT_PUBLIC_* values are baked into the frontend image, so rebuild the
# frontend after changing them: docker compose build frontend
# The browser talks only to the frontend; its Next.js server proxies /api to
# the backend over the internal Docker network. No API URL or public route is
# needed.
# Public URL of the frontend itself, used for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Base domain for links to deployed apps. Defaults to DOMAIN when blank.
NEXT_PUBLIC_DEPLOY_DOMAIN=
# Host port that publishes the frontend container.
FRONTEND_PORT=3000
# Hostnames Traefik uses for the UI. Defaults to harbor.<DOMAIN> when blank.
# This only affects traffic routed through Traefik/Cloudflare; the frontend is
# also reachable directly on FRONTEND_PORT.
FRONTEND_HOST=
